# Test Environment Configuration
NODE_ENV=test
PORT=5001

# Test Database
MONGODB_URI_TEST=mongodb://localhost:27017/car_rental_test

# JWT Configuration (use different secret for tests)
JWT_SECRET=test_jwt_secret_for_testing_purposes_must_be_at_least_64_characters_long_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Rate Limiting 
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Account Lockout
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME_HOURS=2

# Email (use test mode)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=test@carrental.com
