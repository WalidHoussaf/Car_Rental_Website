# Docker Environment Configuration
# Copy this file to .env.docker and update with your values

# ==========================================
# BUILD CONFIGURATION
# ==========================================
BUILD_TARGET=production  # Options: development, production
NODE_ENV=production      # Options: development, production

# ==========================================
# MONGODB CONFIGURATION
# ==========================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme_secure_password_here
MONGO_DATABASE=car_rental
MONGO_PORT=27017

# ==========================================
# BACKEND CONFIGURATION
# ==========================================
BACKEND_PORT=5000
BACKEND_VOLUME_MODE=ro  # ro for production, rw for development

# JWT Configuration (CRITICAL - MUST CHANGE IN PRODUCTION)
# Use the same as the one on the backend environment
JWT_SECRET=your_super_secure_jwt_secret_change_this_in_production_minimum_64_characters
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
FRONTEND_PORT=3000
FRONTEND_INTERNAL_PORT=80  # 80 for production (nginx), 5173 for development (vite)
FRONTEND_VOLUME_MODE=ro    # ro for production, rw for development
FRONTEND_HEALTHCHECK=wget --quiet --tries=1 --spider http://localhost:80/ || exit 1
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api

# ==========================================
# EMAIL CONFIGURATION (Optional)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=Car Rental <noreply@carrental.com>

# ==========================================
# BACKUP CONFIGURATION
# ==========================================
BACKUP_ENABLED=true
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_COUNT=50
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=false
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_change_this_in_production

# Backup Scheduling (cron format)
BACKUP_DAILY_ENABLED=true
BACKUP_DAILY_SCHEDULE=0 2 * * *
BACKUP_WEEKLY_ENABLED=true
BACKUP_WEEKLY_SCHEDULE=0 3 * * 0
BACKUP_MONTHLY_ENABLED=true
BACKUP_MONTHLY_SCHEDULE=0 4 1 * *

# ==========================================
# MONGO EXPRESS (Database Admin UI)
# ==========================================
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=admin

