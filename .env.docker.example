# Docker Environment Configuration
# Copy this file to .env.docker and update with your values

# ==========================================
# BUILD CONFIGURATION
# ==========================================
BUILD_TARGET=production  # Options: development, production
NODE_ENV=production      # Options: development, production

# ==========================================
# MONGODB CONFIGURATION
# ==========================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme_secure_password_here
MONGO_DATABASE=car_rental
MONGO_PORT=27017

# ==========================================
# BACKEND CONFIGURATION
# ==========================================
BACKEND_PORT=5000
BACKEND_VOLUME_MODE=ro  # ro for production, rw for development

# JWT Configuration (CRITICAL - MUST CHANGE IN PRODUCTION)
# Generate secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secure_jwt_secret_change_this_in_production_minimum_64_characters
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
FRONTEND_PORT=3000
FRONTEND_INTERNAL_PORT=80  # 80 for production (nginx), 5173 for development (vite)
FRONTEND_VOLUME_MODE=ro    # ro for production, rw for development
FRONTEND_HEALTHCHECK=wget --quiet --tries=1 --spider http://localhost:80/ || exit 1
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api

# ==========================================
# EMAIL CONFIGURATION (Optional)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=Car Rental <noreply@carrental.com>

# ==========================================
# MONGO EXPRESS (Database Admin UI)
# ==========================================
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=admin

# ==========================================
# SECURITY NOTES
# ==========================================
# 1. NEVER commit .env.docker to version control
# 2. Use strong passwords for production
# 3. Generate a secure JWT_SECRET (minimum 64 characters)
# 4. Change default Mongo Express credentials
# 5. Use environment-specific values for dev/staging/prod
